generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  PARENT
  TUTOR
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EnrollmentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  TRANSFERRED
  SUSPENDED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum TaskStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum EvaluationType {
  EXAM
  QUIZ
  HOMEWORK
  PROJECT
  PARTICIPATION
  OTHER
}

enum EvaluationStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum EvaluationScoreStatus {
  PENDING
  GRADED
  EXEMPT
  MISSING
}

enum EvaluationCalculationMode {
  WEIGHTED_CATEGORIES
  AVERAGE
}

enum NoticeAudience {
  ALL
  PARENTS
  TEACHERS
  STUDENTS
}

enum ScholarshipType {
  FULL
  PARTIAL
  CONDITIONAL
}

enum PlanningStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum NivelEducativo {
  PREESCOLAR
  PRIMARIA
  SECUNDARIA
}

enum SchoolType {
  SCHOOL
  INDEPENDENT
}

enum PlanningModalidad {
  PROYECTOS
  ABJ
  CENTROS_INTERES
  TALLERES_CRITICOS
  RINCONES_APRENDIZAJE
  UNIDADES_DIDACTICAS
}

enum CampoFormativo {
  LENGUAJES
  SABERES_PENSAMIENTO_CIENTIFICO
  ETICA_NATURALEZA_SOCIEDADES
  HUMANO_COMUNITARIO
}

enum EjeArticulador {
  PENSAMIENTO_CRITICO
  VIDA_SALUDABLE
  INCLUSION
  INTERCULTURALIDAD_CRITICA
  IGUALDAD_GENERO
  ARTE_CULTURA
  APROPIACION_TECNOLOGIA
}

enum SolicitudEstado {
  DRAFT
  SUBMITTED
  EN_REVISION
  APROBADA
  MATRICULADO
  RECHAZADA
  CANCELADA
}

enum DocumentoEstado {
  PENDIENTE
  RECIBIDO
  VALIDADO
  RECHAZADO
}

enum CargoEstado {
  PENDIENTE
  PARCIAL
  LIQUIDADO
  VENCIDO
  CANCELADO
}

enum TipoSolicitud {
  INSCRIPCION
  REINSCRIPCION
}

enum TipoCargo {
  INSCRIPCION_AUTOMATICO
  REINSCRIPCION_AUTOMATICO
  MANUAL
}

enum PagoMetodo {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  CHEQUE
  OTRO
}

// ─── ORGANIZATIONS ───────────────────────

model Organization {
  id        String   @id @default(uuid())
  name      String
  rfc       String?
  logoUrl   String?  @map("logo_url")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  schools School[]
  users   User[]

  @@map("organizations")
}

// ─── SCHOOLS ───────────────────────────

model School {
  id             String     @id @default(uuid())
  name           String
  code           String     @unique
  address        String?
  phone          String?
  email          String?
  logoUrl        String?    @map("logo_url")
  active         Boolean    @default(true)
  type           SchoolType @default(SCHOOL)
  organizationId String?    @map("organization_id")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization           Organization?          @relation(fields: [organizationId], references: [id])
  users                  User[]
  schoolModules          SchoolModule[]
  schoolYears            SchoolYear[]
  grades                 Grade[]
  groups                 Group[]
  subjects               Subject[]
  notices                Notice[]
  solicitudesInscripcion SolicitudInscripcion[]
  tiposDocumento         TipoDocumentoEscuela[]
  catalogoCargos         CatalogoCargo[]
  cargos                 Cargo[]
  evaluationCategories   EvaluationCategory[]
  gradingPolicies        GradingPolicy[]
  evaluations            Evaluation[]

  @@map("schools")
}

model SchoolModule {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  module    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, module])
  @@map("school_modules")
}

// ─── SCHOOL YEAR & PERIODS ─────────────

model SchoolYear {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  name      String
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school                 School                 @relation(fields: [schoolId], references: [id])
  periods                Period[]
  groups                 Group[]
  solicitudesInscripcion SolicitudInscripcion[]
  cargos                 Cargo[]

  @@map("school_years")
}

model Period {
  id           String   @id @default(uuid())
  schoolYearId String   @map("school_year_id")
  name         String
  startDate    DateTime @map("start_date")
  endDate      DateTime @map("end_date")
  order        Int
  createdAt    DateTime @default(now()) @map("created_at")

  schoolYear      SchoolYear      @relation(fields: [schoolYearId], references: [id])
  grades          GradeRecord[]
  gradingPolicies GradingPolicy[]
  evaluations     Evaluation[]

  @@map("periods")
}

// ─── USERS & PROFILES ──────────────────

model User {
  id             String   @id @default(uuid())
  schoolId       String?  @map("school_id")
  organizationId String?  @map("organization_id")
  supabaseUid    String   @unique @map("supabase_uid")
  email          String
  role           UserRole
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  phone          String?
  avatarUrl      String?  @map("avatar_url")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  school         School?         @relation(fields: [schoolId], references: [id])
  organization   Organization?   @relation(fields: [organizationId], references: [id])
  teacherProfile TeacherProfile?
  studentProfile StudentProfile?
  parentProfile  ParentProfile?

  // Since schoolId can be null, the unique constraint on [schoolId, email] might not work exactly as before for ORG_ADMINs.
  // But PostgreSQL treats nulls as distinct, so multiple users could have null schoolId and the same email.
  // We'll keep it as is, or rely on supabaseUid uniqueness.
  @@unique([schoolId, email])
  @@map("users")
}

model TeacherProfile {
  id             String    @id @default(uuid())
  userId         String    @unique @map("user_id")
  employeeNumber String?   @map("employee_number")
  specialty      String?
  hireDate       DateTime? @map("hire_date")
  allowedModules String[]  @default([]) @map("allowed_modules")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user               User              @relation(fields: [userId], references: [id])
  groupAssignments   GroupTeacher[]
  subjectAssignments SubjectTeacher[]
  attendanceRecords  Attendance[]
  tasks              Task[]
  plannings          Planning[]
  createdEvaluations Evaluation[]      @relation("EvaluationCreator")
  gradedScores       EvaluationScore[] @relation("EvaluationScoreGrader")

  @@map("teacher_profiles")
}

model StudentProfile {
  id               String    @id @default(uuid())
  userId           String    @unique @map("user_id")
  enrollmentNumber String?   @unique @map("enrollment_number")
  segundoNombre    String?   @map("segundo_nombre")
  segundoApellido  String?   @map("segundo_apellido")
  curp             String?   @unique
  nacionalidad     String?
  birthDate        DateTime? @map("birth_date")
  gender           Gender?
  bloodType        String?   @map("blood_type")
  address          String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user                   User                   @relation(fields: [userId], references: [id])
  enrollments            Enrollment[]
  attendances            Attendance[]
  gradeRecords           GradeRecord[]
  evaluationScores       EvaluationScore[]
  taskDeliveries         TaskDelivery[]
  parentLinks            ParentStudent[]
  scholarships           Scholarship[]
  solicitudesInscripcion SolicitudInscripcion[]
  cargos                 Cargo[]

  @@map("student_profiles")
}

model ParentProfile {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  occupation String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user         User            @relation(fields: [userId], references: [id])
  studentLinks ParentStudent[]

  @@map("parent_profiles")
}

model ParentStudent {
  id               String  @id @default(uuid())
  parentProfileId  String  @map("parent_profile_id")
  studentProfileId String  @map("student_profile_id")
  relationship     String
  isPrimary        Boolean @default(false) @map("is_primary")

  parentProfile  ParentProfile  @relation(fields: [parentProfileId], references: [id])
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])

  @@unique([parentProfileId, studentProfileId])
  @@map("parent_students")
}

// ─── ACADEMIC STRUCTURE ────────────────

model Grade {
  id        String          @id @default(uuid())
  schoolId  String          @map("school_id")
  name      String
  order     Int
  level     NivelEducativo?
  createdAt DateTime        @default(now()) @map("created_at")

  school School  @relation(fields: [schoolId], references: [id])
  groups Group[]

  @@unique([schoolId, level, name])
  @@map("grades")
}

model Group {
  id           String   @id @default(uuid())
  schoolId     String   @map("school_id")
  gradeId      String   @map("grade_id")
  schoolYearId String   @map("school_year_id")
  name         String
  maxStudents  Int?     @map("max_students")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  school             School                 @relation(fields: [schoolId], references: [id])
  grade              Grade                  @relation(fields: [gradeId], references: [id])
  schoolYear         SchoolYear             @relation(fields: [schoolYearId], references: [id])
  teachers           GroupTeacher[]
  enrollments        Enrollment[]
  enrollmentRequests SolicitudInscripcion[]
  attendances        Attendance[]
  tasks              Task[]
  plannings          Planning[]
  gradingPolicies    GradingPolicy[]
  evaluations        Evaluation[]

  @@unique([schoolId, gradeId, schoolYearId, name])
  @@map("groups")
}

model GroupTeacher {
  id               String  @id @default(uuid())
  groupId          String  @map("group_id")
  teacherProfileId String  @map("teacher_profile_id")
  isHomeroom       Boolean @default(false) @map("is_homeroom")

  group          Group          @relation(fields: [groupId], references: [id])
  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id])

  @@unique([groupId, teacherProfileId])
  @@map("group_teachers")
}

model Subject {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  name        String
  code        String?
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  school          School           @relation(fields: [schoolId], references: [id])
  teachers        SubjectTeacher[]
  tasks           Task[]
  grades          GradeRecord[]
  plannings       Planning[]
  gradingPolicies GradingPolicy[]
  evaluations     Evaluation[]

  @@unique([schoolId, name])
  @@map("subjects")
}

model SubjectTeacher {
  id               String @id @default(uuid())
  subjectId        String @map("subject_id")
  teacherProfileId String @map("teacher_profile_id")
  groupId          String @map("group_id")

  subject        Subject        @relation(fields: [subjectId], references: [id])
  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id])

  @@unique([subjectId, teacherProfileId, groupId])
  @@map("subject_teachers")
}

// ─── ENROLLMENTS ───────────────────────

model Enrollment {
  id               String           @id @default(uuid())
  studentProfileId String           @map("student_profile_id")
  groupId          String           @map("group_id")
  status           EnrollmentStatus @default(ACTIVE)
  enrolledAt       DateTime         @default(now()) @map("enrolled_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])
  group          Group          @relation(fields: [groupId], references: [id])

  @@unique([studentProfileId, groupId])
  @@map("enrollments")
}

// ─── ATTENDANCE ────────────────────────

model Attendance {
  id               String           @id @default(uuid())
  groupId          String           @map("group_id")
  studentProfileId String           @map("student_profile_id")
  teacherProfileId String           @map("teacher_profile_id")
  date             DateTime         @db.Date
  status           AttendanceStatus
  notes            String?
  createdAt        DateTime         @default(now()) @map("created_at")

  group          Group          @relation(fields: [groupId], references: [id])
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])
  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id])

  @@unique([groupId, studentProfileId, date])
  @@map("attendances")
}

// ─── GRADES & EVALUATIONS ──────────────

model GradeRecord {
  id               String         @id @default(uuid())
  studentProfileId String         @map("student_profile_id")
  subjectId        String         @map("subject_id")
  periodId         String         @map("period_id")
  evaluationType   EvaluationType @map("evaluation_type")
  score            Decimal        @db.Decimal(5, 2)
  maxScore         Decimal        @default(10) @map("max_score") @db.Decimal(5, 2)
  notes            String?
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])
  subject        Subject        @relation(fields: [subjectId], references: [id])
  period         Period         @relation(fields: [periodId], references: [id])

  @@map("grade_records")
}

// ─── EVALUATIONS ──────────────────────

model EvaluationCategory {
  id            String   @id @default(uuid())
  schoolId      String   @map("school_id")
  name          String
  description   String?
  defaultWeight Decimal? @map("default_weight") @db.Decimal(5, 2)
  active        Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  school        School                @relation(fields: [schoolId], references: [id])
  evaluations   Evaluation[]
  policyWeights GradingPolicyWeight[]

  @@unique([schoolId, name])
  @@index([schoolId, active, order])
  @@map("evaluation_categories")
}

model GradingPolicy {
  id              String                    @id @default(uuid())
  schoolId        String                    @map("school_id")
  groupId         String                    @map("group_id")
  subjectId       String                    @map("subject_id")
  periodId        String                    @map("period_id")
  calculationMode EvaluationCalculationMode @default(WEIGHTED_CATEGORIES) @map("calculation_mode")
  scaleMax        Decimal                   @default(10) @map("scale_max") @db.Decimal(5, 2)
  passingScore    Decimal                   @default(6) @map("passing_score") @db.Decimal(5, 2)
  closedAt        DateTime?                 @map("closed_at")
  finalSnapshots  Json?                     @map("final_snapshots")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")

  school  School                @relation(fields: [schoolId], references: [id])
  group   Group                 @relation(fields: [groupId], references: [id])
  subject Subject               @relation(fields: [subjectId], references: [id])
  period  Period                @relation(fields: [periodId], references: [id])
  weights GradingPolicyWeight[]

  @@unique([groupId, subjectId, periodId])
  @@index([schoolId, periodId])
  @@map("grading_policies")
}

model GradingPolicyWeight {
  id         String  @id @default(uuid())
  policyId   String  @map("policy_id")
  categoryId String  @map("category_id")
  weight     Decimal @db.Decimal(5, 2)

  policy   GradingPolicy      @relation(fields: [policyId], references: [id], onDelete: Cascade)
  category EvaluationCategory @relation(fields: [categoryId], references: [id])

  @@unique([policyId, categoryId])
  @@map("grading_policy_weights")
}

model Evaluation {
  id               String           @id @default(uuid())
  schoolId         String           @map("school_id")
  groupId          String           @map("group_id")
  subjectId        String           @map("subject_id")
  periodId         String           @map("period_id")
  categoryId       String           @map("category_id")
  teacherProfileId String           @map("teacher_profile_id")
  title            String
  description      String?
  evaluationDate   DateTime         @map("evaluation_date") @db.Date
  maxScore         Decimal          @default(10) @map("max_score") @db.Decimal(5, 2)
  status           EvaluationStatus @default(DRAFT)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  school         School             @relation(fields: [schoolId], references: [id])
  group          Group              @relation(fields: [groupId], references: [id])
  subject        Subject            @relation(fields: [subjectId], references: [id])
  period         Period             @relation(fields: [periodId], references: [id])
  category       EvaluationCategory @relation(fields: [categoryId], references: [id])
  teacherProfile TeacherProfile     @relation("EvaluationCreator", fields: [teacherProfileId], references: [id])
  scores         EvaluationScore[]

  @@index([schoolId, groupId, periodId])
  @@index([groupId, subjectId, periodId])
  @@map("evaluations")
}

model EvaluationScore {
  id                       String                @id @default(uuid())
  evaluationId             String                @map("evaluation_id")
  studentProfileId         String                @map("student_profile_id")
  score                    Decimal?              @db.Decimal(5, 2)
  status                   EvaluationScoreStatus @default(PENDING)
  feedback                 String?
  gradedAt                 DateTime?             @map("graded_at")
  gradedByTeacherProfileId String?               @map("graded_by_teacher_profile_id")
  createdAt                DateTime              @default(now()) @map("created_at")
  updatedAt                DateTime              @updatedAt @map("updated_at")

  evaluation      Evaluation      @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  studentProfile  StudentProfile  @relation(fields: [studentProfileId], references: [id])
  gradedByTeacher TeacherProfile? @relation("EvaluationScoreGrader", fields: [gradedByTeacherProfileId], references: [id])

  @@unique([evaluationId, studentProfileId])
  @@index([studentProfileId])
  @@map("evaluation_scores")
}

// ─── TASKS ─────────────────────────────

model Task {
  id               String     @id @default(uuid())
  groupId          String     @map("group_id")
  subjectId        String     @map("subject_id")
  teacherProfileId String     @map("teacher_profile_id")
  title            String
  description      String?
  dueDate          DateTime?  @map("due_date")
  maxScore         Decimal?   @map("max_score") @db.Decimal(5, 2)
  status           TaskStatus @default(DRAFT)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  group          Group          @relation(fields: [groupId], references: [id])
  subject        Subject        @relation(fields: [subjectId], references: [id])
  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id])
  deliveries     TaskDelivery[]

  @@map("tasks")
}

model TaskDelivery {
  id               String   @id @default(uuid())
  taskId           String   @map("task_id")
  studentProfileId String   @map("student_profile_id")
  fileUrl          String?  @map("file_url")
  notes            String?
  score            Decimal? @db.Decimal(5, 2)
  deliveredAt      DateTime @default(now()) @map("delivered_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  task           Task           @relation(fields: [taskId], references: [id])
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])

  @@unique([taskId, studentProfileId])
  @@map("task_deliveries")
}

// ─── COMMUNICATIONS ────────────────────

model Notice {
  id        String         @id @default(uuid())
  schoolId  String         @map("school_id")
  title     String
  body      String
  audience  NoticeAudience @default(ALL)
  pinned    Boolean        @default(false)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id])

  @@map("notices")
}

// ─── PLANNING ──────────────────────────

model Planning {
  id                    String            @id @default(uuid())
  teacherProfileId      String            @map("teacher_profile_id")
  groupId               String?           @map("group_id")
  subjectId             String?           @map("subject_id")
  isStandalone          Boolean           @default(false) @map("is_standalone")
  standaloneLevel       NivelEducativo?   @map("standalone_level")
  standaloneGradeOrder  Int?              @map("standalone_grade_order")
  modalidad             PlanningModalidad
  campoFormativo        CampoFormativo
  ejesArticuladores     EjeArticulador[]
  contextoInicial       String            @map("contexto_inicial")
  // Legacy fields (kept for backward compat, now also stored in fundamentacion)
  contenidos            String            @default("")
  pda                   String            @default("") @map("pda")
  relevanciaSocial      String            @default("") @map("relevancia_social")
  produccionSugerida    String            @default("") @map("produccion_sugerida")
  // Legacy fases (kept, but matrizDidactica is the new format)
  fases                 Json              @default("[]")
  recursos              Json?
  title                 String
  content               String            @default("")
  weekStart             DateTime          @map("week_start") @db.Date
  status                PlanningStatus    @default(DRAFT)
  // New Sara format fields
  periodoProyecto       String?           @map("periodo_proyecto")
  startDate             DateTime?         @map("start_date") @db.Date
  endDate               DateTime?         @map("end_date") @db.Date
  activitiesPerDay      Int?              @default(1) @map("activities_per_day")
  problematica          String?
  proposito             String?
  instrumentoEvaluacion String[]          @default([]) @map("instrumento_evaluacion")
  ajustesRazonables     String[]          @default([]) @map("ajustes_razonables")
  actividadesPmc        String[]          @default([]) @map("actividades_pmc")
  fundamentacion        Json? // [{campoFormativo, nombreCampo, contenido, pda}]
  matrizDidactica       Json?             @map("matriz_didactica") // [{momento, filas:[{actividades,campo_pda,organizacion,recursos,evaluacion}]}]
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id])
  group          Group?         @relation(fields: [groupId], references: [id])
  subject        Subject?       @relation(fields: [subjectId], references: [id])

  @@map("plannings")
}

// ─── SCHOLARSHIPS ──────────────────────

model Scholarship {
  id               String          @id @default(uuid())
  studentProfileId String          @map("student_profile_id")
  type             ScholarshipType
  percentage       Decimal         @db.Decimal(5, 2)
  reason           String?
  startDate        DateTime        @map("start_date") @db.Date
  endDate          DateTime?       @map("end_date") @db.Date
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])

  @@map("scholarships")
}

// ─── ENROLLMENTS MODULE ────────────────

model SolicitudInscripcion {
  id               String  @id @default(uuid())
  schoolId         String  @map("school_id")
  schoolYearId     String? @map("school_year_id")
  studentProfileId String? @map("student_profile_id")

  tipoSolicitud TipoSolicitud @default(INSCRIPCION) @map("tipo_solicitud")

  // Nombre completo separado
  primerNombre    String  @map("primer_nombre")
  segundoNombre   String? @map("segundo_nombre")
  primerApellido  String  @map("primer_apellido")
  segundoApellido String? @map("segundo_apellido")

  // Campos legacy (retrocompatibilidad)
  firstName String @default("") @map("first_name")
  lastName  String @default("") @map("last_name")

  birthDate          DateTime? @map("birth_date")
  gender             Gender?
  curp               String?
  nacionalidad       String?
  bloodType          String?   @map("blood_type")
  address            String?
  escuelaProcedencia String?   @map("escuela_procedencia")

  nivelEducativo NivelEducativo? @map("nivel_educativo")
  gradeId        String?         @map("grade_id") // FK a grades
  groupId        String?         @map("group_id") // grupo objetivo

  estado         SolicitudEstado @default(DRAFT)
  motivoRechazo  String?         @map("motivo_rechazo")
  rechazadoPorId String?         @map("rechazado_por_id")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  school         School          @relation(fields: [schoolId], references: [id])
  schoolYear     SchoolYear?     @relation(fields: [schoolYearId], references: [id])
  studentProfile StudentProfile? @relation(fields: [studentProfileId], references: [id])
  group          Group?          @relation(fields: [groupId], references: [id])

  documentos DocumentoSolicitud[]
  padres     DatosPadreSolicitud[]
  cargos     Cargo[]

  @@map("solicitudes_inscripcion")
}

model DocumentoSolicitud {
  id                     String          @id @default(uuid())
  solicitudInscripcionId String          @map("solicitud_inscripcion_id")
  tipoDocumentoId        String?         @map("tipo_documento_id") // FK configurable
  tipoDocumento          String          @map("tipo_documento") // slug legacy/fallback
  nombreDocumento        String?         @map("nombre_documento") // nombre legible
  obligatorio            Boolean         @default(false)
  fileUrl                String?         @map("file_url")
  estado                 DocumentoEstado @default(PENDIENTE)
  observaciones          String?
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  solicitud  SolicitudInscripcion  @relation(fields: [solicitudInscripcionId], references: [id], onDelete: Cascade)
  tipoDocRef TipoDocumentoEscuela? @relation(fields: [tipoDocumentoId], references: [id])

  @@map("documentos_solicitud")
}

model DatosPadreSolicitud {
  id                     String @id @default(uuid())
  solicitudInscripcionId String @map("solicitud_inscripcion_id")

  primerNombre    String  @map("primer_nombre")
  segundoNombre   String? @map("segundo_nombre")
  primerApellido  String  @map("primer_apellido")
  segundoApellido String? @map("segundo_apellido")

  // Campos legacy
  firstName String @default("") @map("first_name")
  lastName  String @default("") @map("last_name")

  email             String
  phone             String?
  relationship      String
  domicilio         String?
  identificacionUrl String? @map("identificacion_url")
  isPrimary         Boolean @default(false) @map("is_primary")

  solicitud SolicitudInscripcion @relation(fields: [solicitudInscripcionId], references: [id], onDelete: Cascade)

  @@map("datos_padres_solicitud")
}

// ─── FINANCE MODULE ────────────────────

model TipoDocumentoEscuela {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  nombre      String
  slug        String
  descripcion String?
  obligatorio Boolean  @default(false)
  activo      Boolean  @default(true)
  orden       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  school     School               @relation(fields: [schoolId], references: [id])
  documentos DocumentoSolicitud[]

  @@unique([schoolId, slug])
  @@map("tipos_documento_escuela")
}

model CatalogoCargo {
  id          String    @id @default(uuid())
  schoolId    String    @map("school_id")
  nombre      String
  descripcion String?
  monto       Decimal   @db.Decimal(10, 2)
  tipo        TipoCargo @default(MANUAL)
  activo      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  school School  @relation(fields: [schoolId], references: [id])
  cargos Cargo[]

  @@unique([schoolId, nombre])
  @@map("catalogo_cargos")
}

model Cargo {
  id                     String      @id @default(uuid())
  schoolId               String      @map("school_id")
  studentProfileId       String      @map("student_profile_id")
  schoolYearId           String?     @map("school_year_id")
  catalogoCargoId        String?     @map("catalogo_cargo_id")
  solicitudInscripcionId String?     @map("solicitud_inscripcion_id")
  concepto               String
  monto                  Decimal     @db.Decimal(10, 2)
  saldo                  Decimal     @default(0) @db.Decimal(10, 2)
  fechaVencimiento       DateTime?   @map("fecha_vencimiento")
  estado                 CargoEstado @default(PENDIENTE)
  notas                  String?
  createdAt              DateTime    @default(now()) @map("created_at")
  updatedAt              DateTime    @updatedAt @map("updated_at")

  school         School                @relation(fields: [schoolId], references: [id])
  studentProfile StudentProfile        @relation(fields: [studentProfileId], references: [id])
  schoolYear     SchoolYear?           @relation(fields: [schoolYearId], references: [id])
  catalogoCargo  CatalogoCargo?        @relation(fields: [catalogoCargoId], references: [id])
  solicitud      SolicitudInscripcion? @relation(fields: [solicitudInscripcionId], references: [id], onDelete: SetNull)
  pagos          Pago[]

  @@map("cargos")
}

model Pago {
  id         String     @id @default(uuid())
  cargoId    String     @map("cargo_id")
  monto      Decimal    @db.Decimal(10, 2)
  metodo     PagoMetodo @default(EFECTIVO)
  referencia String?
  notas      String?
  creadoPor  String?    @map("creado_por")
  createdAt  DateTime   @default(now()) @map("created_at")

  cargo Cargo @relation(fields: [cargoId], references: [id], onDelete: Cascade)

  @@map("pagos")
}
